#!/usr/bin/env bash
# Configures Nginx to run as the nginx user and listen on port 8080
sed -i "s/^#\?user .*;/user nginx;/" /etc/nginx/nginx.conf
sed -i "s/listen 80 default_server;/listen 8080 default_server;/; s/listen \[::\]:80 default_server;/listen [::]:8080 default_server;/" /etc/nginx/sites-enabled/default
chmod 644 /etc/nginx/nginx.conf
pkill apache2
sudo -u nginx service nginx restart
